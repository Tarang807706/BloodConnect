# ==============================================================
# BLOODCONNECT ENVIRONMENT CONFIGURATION
# ==============================================================

# Node Environment
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# Database Connection (PostgreSQL)
# For local dev without Postgres, fallback mode or embedded storage runs automatically
DATABASE_URL=postgresql://bloodconnect:bloodconnect_pass@localhost:5432/bloodconnect_db?schema=public

# Authentication Secrets (Generate secure 256-bit keys in production)
JWT_ACCESS_SECRET=bloodconnect_super_secret_access_jwt_key_2026
JWT_REFRESH_SECRET=bloodconnect_super_secret_refresh_jwt_key_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Safety & Coordination Orchestrator Config
ORCHESTRATOR_STAGE_1_TIMEOUT_MIN=10
ORCHESTRATOR_STAGE_2_TIMEOUT_MIN=10
ORCHESTRATOR_STAGE_3_TIMEOUT_MIN=15
ORCHESTRATOR_MIN_RESPONSES_FACTOR=1.5
LOCATION_APPROX_DECIMALS=2

# Maps & Geolocation
MAP_PROVIDER=haversine
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Email / Notifications (mock or SMTP)
EMAIL_FROM=no-reply@bloodconnect.local
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
ENABLE_MOCK_NOTIFICATIONS=true
